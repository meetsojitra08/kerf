# PostgreSQL + pgvector
POSTGRES_USER=kerf
POSTGRES_PASSWORD=kerf_secret
POSTGRES_DB=kerf
POSTGRES_PORT=5434
DATABASE_URL=postgresql+asyncpg://kerf:kerf_secret@localhost:5434/kerf

# Redis 7
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# MinIO (S3-compatible)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9010
MINIO_CONSOLE_PORT=9011
S3_ENDPOINT=http://localhost:9010
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=kerf-media
S3_REGION=us-east-1

# Auth
JWT_SECRET=dev_kerf_jwt_secret_key_change_in_production_min32chars
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# Ports & Hosts
API_HOST=0.0.0.0
API_PORT=8000
VITE_API_BASE_URL=http://localhost:8000
